function FindProxyForURL(url, host){
    var pac = 'PROXY 127.0.0.1:26501';
    if (shExpMatch(host, 'pinterest.com')) return pac;
    if (shExpMatch(host, 'pinimg.com')) return pac;
    if (shExpMatch(host, 'artstation.com')) return pac;
    if (shExpMatch(host, 'v2ex.com')) return pac;
    if (shExpMatch(host, '*.v2ex.com')) return pac;
    if (shExpMatch(host, 'imgur.com')) return pac;
    if (shExpMatch(host, 'pixivsketch.net')) return pac;
    if (shExpMatch(host, 'sketch.pixiv.net')) return pac;
    if (shExpMatch(host, 'pximg.net')) return pac;
    if (shExpMatch(host, '*.pximg.net')) return pac;
    if (shExpMatch(host, 'vercel.app')) return pac;
    if (shExpMatch(host, '*.vercel.app')) return pac;
    if (shExpMatch(host, 'pixiv.net')) return pac;
    if (shExpMatch(host, '*.pixiv.net')) return pac;
    if (shExpMatch(host, 'in.appcenter.ms')) return pac;
    if (shExpMatch(host, 'appcenter.ms')) return pac;
    if (shExpMatch(host, '*.appcenter.ms')) return pac;
    if (shExpMatch(host, 'fonts.gstatic.com')) return pac;
    if (shExpMatch(host, 'gravatar.com')) return pac;
    if (shExpMatch(host, 'themes.googleusercontent.com')) return pac;
    if (shExpMatch(host, 'ajax.googleapis.com')) return pac;
    if (shExpMatch(host, 'fonts.googleapis.com')) return pac;
    if (shExpMatch(host, 'maxcdn.bootstrapcdn.com/bootstrap')) return pac;
    if (shExpMatch(host, 'google.com/recaptcha')) return pac;
    if (shExpMatch(host, 'google.com')) return pac;
    if (shExpMatch(host, 'hcaptcha.com')) return pac;
    if (shExpMatch(host, 'arkoselabs.com')) return pac;
    if (shExpMatch(host, 'api.github.com')) return pac;
    if (shExpMatch(host, 'gist.github.com')) return pac;
    if (shExpMatch(host, 'githubusercontent.com')) return pac;
    if (shExpMatch(host, 'raw.github.com')) return pac;
    if (shExpMatch(host, 'github.com')) return pac;
    if (shExpMatch(host, '*.github.com')) return pac;
    if (shExpMatch(host, 'githubapp.com')) return pac;
    if (shExpMatch(host, 'github.io')) return pac;
    if (shExpMatch(host, 'storage.live.com')) return pac;
    if (shExpMatch(host, 'skyapi.onedrive.live.com')) return pac;
    if (shExpMatch(host, 'onedrive.live.com')) return pac;
    if (shExpMatch(host, 'onedrive.live')) return pac;
    if (shExpMatch(host, 'mega.co.nz')) return pac;
    if (shExpMatch(host, '*.mega.co.nz')) return pac;
    if (shExpMatch(host, 'mega.nz')) return pac;
    if (shExpMatch(host, 'mega.io')) return pac;
    if (shExpMatch(host, '*.mega.io')) return pac;
    if (shExpMatch(host, 'aem.dropbox.com')) return pac;
    if (shExpMatch(host, 'dropbox.com')) return pac;
    if (shExpMatch(host, 'dl.dropboxusercontent.com')) return pac;
    if (shExpMatch(host, '*.dl.dropboxusercontent.com')) return pac;
    return 'DIRECT';
}
