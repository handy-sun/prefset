[wsl2]
# 限制容器内存上限, 根据各自机器及需求设置
memory=8GB
# 配置网络模式为镜像模式，网络将于宿主机相同
networkingMode=mirrored
# 更改将 DNS 请求从 WSL 代理到 Windows 的方式
dnsTunneling=true
# 如果设置为 true，则 Windows 防火墙规则以及特定于 Hyper-V 流量的规则可以筛选 WSL 网络流量
firewall=true
# 关闭图形化，规避抢夺程序焦点的问题
guiApplications=false
# 强制 WSL 使用 Windows 的 HTTP 代理信息,是否打开看个人的需要（默认值为false）
autoProxy=false

#kernel=C:\\Intel\\kernel.img

## pre-release
# virtio=true
# virtiofs=true
# hostFileSystemAccess=true

[experimental]
# 检测空闲 CPU 使用率后，自动释放缓存的内存。 设置为 gradual 以慢速释放，设置为 dropcache 以立即释放缓存的内存。（默认值为dropCache）
autoMemoryReclaim=gradual

# 仅当 wsl2.networkingMode 设置为 mirrored 时才适用。 如果设置为 True，将会允许容器通过分配给主机的 IP 地址连接到主机，或允许主机通过此方式连接到容器。 请注意，始终可以使用 127.0.0.1 环回地址 - 此选项也允许使用所有额外分配的本地 IP 地址。
# 仅在 Windows 11 上可用
hostAddressLoopback=true

# 仅当 wsl2.networkingMode 设置为 mirrored 时才适用。 指定 Linux 应用程序可以绑定到哪些端口（即使该端口已在 Windows 中使用）。 通过此设置，应用程序能够仅侦听 Linux 中的流量端口，因此即使该端口在 Windows 上用于其他用途，这些应用程序也不会被阻止。 例如，WSL 将允许绑定到 Linux for Docker Desktop 中的端口 53，因为它只侦听来自 Linux 容器中的请求。 应在逗号分隔列表中设置格式，例如：3000,9000,9090（默认值为Null）
# 仅在 Windows 11 上可用
ignoredPorts=22

# 如果设置为 true，则任何新创建的 VHD 将自动设置为稀疏。
sparseVhd=true
# vim: set ft=dosini :
