{
    "editor.fontSize": 20,
    "workbench.colorTheme": "Atom One Dark",
    "workbench.startupEditor": "newUntitledFile",
    "debug.onTaskErrors": "showErrors",
    "task.slowProviderWarning": [
        "npm"
    ],
    "cmake.configureOnOpen": true,
    "editor.columnSelection": false,
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.quickSuggestions": {
            "comments": "on",
            "strings": "on",
            "other": "on"
        }
    },
    "C_Cpp.clang_format_fallbackStyle": "LLVM",
    "python.showStartPage": false,
    "python.pythonPath": "C:\\Python38\\python.exe",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "files.autoGuessEncoding": true,
    "files.defaultLanguage": "${activeEditorLanguage}",
    "launch": {
        "configurations": [
        // "https://marketplace.visualstudio.com/items?itemName=ms-azuretools.vscode-docker",
        ]
    },
    "terminal.integrated.fontSize": 18,
    "security.workspace.trust.untrustedFiles": "open",
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "git.enableSmartCommit": true,
    "background.enabled": false,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    // 关闭检测第一个tab后面就tab
    "editor.detectIndentation": false,
    // 制表符显示->
    "editor.renderControlCharacters": true,
    // 空格显示...
    "editor.renderWhitespace": "all", 
    // tab为四个空格
    "editor.tabSize": 4,
    // 转为空格
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {

        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "editor.minimap.enabled": false,
    "C_Cpp.autocomplete": "default",
    "[c]": {
        "editor.quickSuggestions": {
            "comments": "on",
            "strings": "on",
            "other": "on"
        },
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "editor.suggest.snippetsPreventQuickSuggestions": false,

    "hexeditor.columnWidth": 16,
    "hexeditor.showDecodedText": true,
    "hexeditor.defaultEndianness": "little",
    "hexeditor.inspectorType": "aside",
    "explorer.confirmDelete": false,
    "git.confirmSync": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "clangd.detectExtensionConflicts": false,
    "git.openRepositoryInParentFolders": "never",
    // "C_Cpp.intelliSenseEngine": "disabled"
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.cStandard": "c99",
    "git.mergeEditor": false,
    // !!! custom theme
    "editor.tokenColorCustomizations": {
        "comments": "#57943d",
        "textMateRules": [
            {
                "scope": [
                    "entity.name.type", // typedef? 类型
                    "storage.type.built-in.primitive.c", //自带的类型
                    "storage.modifier", // const, static
                    "storage.type", // struct class
                    "keyword.operator.sizeof", // sizeof
                    "keyword.operator.alignof", // alignof
                    "constant.language" // .nullptr.cpp
                ],
                "settings": {
                    "foreground": "#cc7832"
                }
            },
            {
                "scope": [
                    "entity.name.function" // 函数
                ],
                "settings": {
                    "foreground": "#4f92ec"
                }
            },
            {
                "scope": [
                    "entity.name.function.member.static.cpp" // 静态成员函数
                ],
                "settings": {
                    "foreground": "#4f92ec",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "entity.name.type.cpp" // type
                ],
                "settings": {
                    "foreground": "#d6bf55"
                }
            },
            {
                "scope": [
                    "entity.name.namespace", // namespace
                    "storage.modifier.package.java"
                ],
                "settings": {
                    "foreground": "#008080"
                }
            },
            {
                "scope": [
                    "variable.other.enummember.cpp" // enum element
                ],
                "settings": {
                    "foreground": "#ae8abe",
                    "fontStyle": "italic bold"
                }
            },
            {
                "scope": [
                    "constant.other.placeholder" // %d, %s, ...
                ],
                "settings": {
                    "foreground": "#2caf72",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "keyword.operator",
                    "meta.block.class.cpp",
                    "storage.modifier.reference.cpp" // &
                ],
                "settings": {
                    "foreground": "#aaaaaa"
                }
            },
            {
                "scope": [
                    "variable.other.global" // global variable
                ],
                "settings": {
                    "foreground": "#ce5c00",
                    "fontStyle": "italic bold"
                }
            },
            {
                "scope": [
                    "entity.name.function.preprocessor" // macro
                ],
                "settings": {
                    "foreground": "#a056a7",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "support.other.attribute.cpp",// __attribute__
                    "keyword.control.directive" // #include, #ifdef, #define
                ],
                "settings": {
                    "foreground": "#948b8b"
                }
            },
            {
                "scope": [
                    "keyword.control" // if, return...
                ],
                "settings": {
                    "foreground": "#9b733e"
                }
            },
            {
                "scope": [
                    "variable.other.local", // 局部变量
                    "variable.parameter" // 形参
                ],
                "settings": {
                    "foreground": "#30bcbc"
                }
            },
            {
                "scope": [
                    "variable.other.property" // 字段 Field(member variable)
                ],
                "settings": {
                    "foreground": "#ff6b68"
                }
            },
            {
                "scope": [
                    "variable.other.property.static.cpp"// static member variable
                ],
                "settings": {
                    "foreground": "#ff6b68",
                    "fontStyle": "italic bold"
                }
            },
            {
                "scope": [
                    "constant.numeric" // 数值常量
                ],
                "settings": {
                    "foreground": "#b5cea8"
                }
            }
        ]
    },

    "editor.inlayHints.enabled": "offUnlessPressed"
}