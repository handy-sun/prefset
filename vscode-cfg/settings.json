{
    // !!! custom theme
    "editor.tokenColorCustomizations": {
        "comments": "#57943d",
        "textMateRules": [
            {
                "scope": [
                    "entity.name.type", // typedef? 类型
                    "storage.type.built-in.primitive.c", //自带的类型
                    "storage.modifier", // const, static
                    "storage.type", // struct class
                    "keyword.operator.sizeof", // sizeof
                    "keyword.operator.alignof", // alignof
                    "constant.language" // .nullptr.cpp
                ],
                "settings": {
                    "foreground": "#cc7832"
                }
            },
            {
                "scope": [
                    "entity.name.function" // 函数
                ],
                "settings": {
                    "foreground": "#4f92ec"
                }
            },
            {
                "scope": [
                    "entity.name.function.member.static.cpp" // 静态成员函数
                ],
                "settings": {
                    "foreground": "#4f92ec",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "entity.name.type.cpp" // type
                ],
                "settings": {
                    "foreground": "#d6bf55"
                }
            },
            {
                "scope": [
                    "entity.name.namespace" // namespace
                ],
                "settings": {
                    "foreground": "#008080"
                }
            },
            {
                "scope": [
                    "variable.other.enummember.cpp" // enum element
                ],
                "settings": {
                    "foreground": "#ae8abe",
                    "fontStyle": "italic bold"
                }
            },
            {
                "scope": [
                    "constant.other.placeholder" // %d, %s, ...
                ],
                "settings": {
                    "foreground": "#2caf72",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "keyword.operator",
                    "meta.block.class.cpp",
                    "storage.modifier.reference.cpp" // &
                ],
                "settings": {
                    "foreground": "#aaaaaa"
                }
            },
            {
                "scope": [
                    "variable.other.global" // global variable
                ],
                "settings": {
                    "foreground": "#ce5c00",
                    "fontStyle": "italic bold"
                }
            },
            {
                "scope": [
                    "entity.name.function.preprocessor" // macro
                ],
                "settings": {
                    "foreground": "#a056a7",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "support.other.attribute.cpp",// __attribute__
                    "keyword.control.directive" // #include, #ifdef, #define
                ],
                "settings": {
                    "foreground": "#948b8b"
                }
            },
            {
                "scope": [
                    "keyword.control" // if, return...
                ],
                "settings": {
                    "foreground": "#9b733e"
                }
            },
            {
                "scope": [
                    "variable.other.local", // 局部变量
                    "variable.parameter" // 形参
                ],
                "settings": {
                    "foreground": "#30bcbc"
                }
            },
            {
                "scope": [
                    "variable.other.property" // 字段 Field(member variable)
                ],
                "settings": {
                    "foreground": "#ff6b68"
                }
            },
            {
                "scope": [
                    "variable.other.property.static.cpp"// static member variable
                ],
                "settings": {
                    "foreground": "#ff6b68",
                    "fontStyle": "italic bold"
                }
            },
            {
                "scope": [
                    "constant.numeric" // 数值常量
                ],
                "settings": {
                    "foreground": "#b5cea8"
                }
            }
        ]
    },
    "editor.fontSize": 16,
    "editor.wordWrap": "on",
    "editor.fontFamily": "'Droid Sans Mono', 'SF Mono', 'NotoMono Nerd Font Mono', monospace",
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.detectIndentation": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.renderControlCharacters": true,
    "editor.renderWhitespace": "all", 
    "editor.columnSelection": false,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.enabled": false,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.accessibilitySupport": "off",
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "terminal.integrated.fontFamily": "'Droid Sans Mono', 'NotoMono Nerd Font Mono', 'SF Mono', Consolas",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.enableFileLinks": "notRemote",
    "terminal.integrated.persistentSessionScrollback": 500,
    "terminal.integrated.scrollback": 9000,
    "update.mode": "default",
    "vsicons.dontShowNewVersionMessage": true,
    "extensions.autoUpdate": false,
    "workbench.iconTheme": "vscode-icons",
    "workbench.colorTheme": "Atom One Dark",
    "workbench.startupEditor": "newUntitledFile",
    "debug.onTaskErrors": "showErrors",
    "task.slowProviderWarning": [
        "npm"
    ],
    "files.autoGuessEncoding": true,
    "files.defaultLanguage": "${activeEditorLanguage}",
    "files.associations": {
        "*.S": "asm",
        "default": "ini",
        "vimrc": "ini",
        "*.yml": "yaml",
        "*.toml": "toml",
        "*.plist": "xml",
        "config": "ini"
    },
    "launch": {
        "configurations": [
            // "https://marketplace.visualstudio.com/items?itemName=ms-azuretools.vscode-docker",
        ]
    },
    "security.workspace.trust.untrustedFiles": "open",
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "remote.SSH.configFile": "~/.ssh/config",
    "remote.SSH.remotePlatform": {
        "manlan": "linux",
        "handyMac": "macOS"
    },
    "hexeditor.columnWidth": 16,
    "hexeditor.showDecodedText": true,
    "hexeditor.defaultEndianness": "little",
    "hexeditor.inspectorType": "aside",
    "explorer.confirmDelete": false,
    "clangd.detectExtensionConflicts": false,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "never",
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.clang_format_fallbackStyle": "LLVM",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.formatting": "clangFormat",
    "markdown-preview-enhanced.previewTheme": "atom-light.css",
    "redhat.telemetry.enabled": true,
    "settingsSync.ignoredExtensions": [
        "ms-python.python",
        "github.copilot",
        "github.copilot-chat",
        "vscjava.vscode-java-test",
        "continue.continue",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.remote-explorer"
    ],
    "cmake.configureOnOpen": true,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "[python]": {
        "editor.formatOnType": true
    },
    "[lua]": {
        "editor.insertSpaces": false,
        // "editor.defaultFormatter": "JohnnyMorganz.stylua",
    },
    "[javascript]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    "[cpp]": {
        // "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.quickSuggestions": {
            "comments": "on",
            "strings": "on",
            "other": "on"
        }
    },
    "[c]": {
        "editor.quickSuggestions": {
            "comments": "on",
            "strings": "on",
            "other": "on"
        },
        // "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    },
    "rust-analyzer.lens.implementations.enable": false,
    "gitlens.codeLens.enabled": false,
    "gitlens.advanced.messages": {
        "suppressLineUncommittedWarning": true
    },
    "colorize.languages": [
        "javascript",
        "lua",
        "toml"
    ],
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "shellscript": false,
        "nix": false,
        "javascript": true,
        "typescript": true,
        "json": false,
        "typescript": true
    },
    "github.copilot.nextEditSuggestions.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "security.promptForLocalFileProtocolHandling": false,
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nil", // or "nixd", or ["executable", "argument1", ...]
    // LSP config can be passed via the ``nix.serverSettings.{lsp}`` as shown below.
    "nix.serverSettings": {
        // check https://github.com/oxalica/nil/blob/main/docs/configuration.md for all options available
        "nil": {
        // "diagnostics": {
        //  "ignored": ["unused_binding", "unused_with"],
        // },
            "formatting": {
                "command": ["nixfmt"],
            },
        },
        // check https://github.com/nix-community/nixd/blob/main/nixd/docs/configuration.md for all nixd config
        // "nixd": {
        //     "formatting": {
        //         "command": ["nixfmt"],
        //     },
        //     "options": {
        //         // By default, this entry will be read from `import <nixpkgs> { }`.
        //         // You can write arbitrary Nix expressions here, to produce valid "options" declaration result.
        //         // Tip: for flake-based configuration, utilize `builtins.getFlake`
        //         "nixos": {
        //         "expr": "(builtins.getFlake \"/absolute/path/to/flake\").nixosConfigurations.<name>.options",
        //         },
        //         "home-manager": {
        //         "expr": "(builtins.getFlake \"/absolute/path/to/flake\").homeConfigurations.<name>.options",
        //         },
        //         // Tip: use ${workspaceFolder} variable to define path
        //         "nix-darwin": {
        //         "expr": "(builtins.getFlake \"${workspaceFolder}/path/to/flake\").darwinConfigurations.<name>.options",
        //         },
        //     },
        // }
    },
    "claudeCode.preferredLocation": "panel",
    "claudeCode.selectedModel": "glm-5",
    "remote.SSH.useLocalServer": false,
    "claudeCode.autosave": false,
    "chat.mcp.gallery.enabled": true,
    "roo-cline.debug": false,
    "roo-cline.allowedCommands": [
        "git log",
        "git diff",
        "git show"
    ],
    "roo-cline.deniedCommands": [],
    "explorer.confirmDragAndDrop": false
}
